# Backend environment variables. Copy to .env and set values.
# Used by: app, worker, tests (copy to .env for local/CI).

# Auth
JWT_SECRET=your-secret-change-in-production
JWT_EXPIRE=7d

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost,http://localhost:3001,http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/template-manager
MONGODB_TEST_URI=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elastic-password
ELASTICSEARCH_CA_FINGERPRINT=
ELASTICSEARCH_TLS_SKIP_VERIFY=true
ELASTIC_PASSWORD=your-elastic-password

# Storage
STORAGE_TYPE=local
UPLOAD_PATH=./uploads
BASE_URL=http://localhost:3000
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://storage.yandexcloud.net

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
