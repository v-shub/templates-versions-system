# Root .env: used by docker-compose.yml (variable substitution and env_file).
# Copy to .env and adjust. Do not commit .env.

# Backend
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost,http://localhost:3001,http://localhost:3000
MONGODB_URI=mongodb://mongodb:27017/template-manager
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elastic-password
ELASTICSEARCH_CA_FINGERPRINT=
ELASTICSEARCH_TLS_SKIP_VERIFY=true
STORAGE_TYPE=local
UPLOAD_PATH=./uploads
BASE_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRE=7d
LOG_LEVEL=info
LOG_DIR=./logs
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://storage.yandexcloud.net

# Frontend (Docker build arg)
REACT_APP_API_URL=/api

# MongoDB
MONGO_INITDB_DATABASE=template-manager

# Elasticsearch
ELASTIC_PASSWORD=your-elastic-password
